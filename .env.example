# MongoDB Configuration (双库)
# SmartCare 主库
MONGO_HOST=your_mongodb_host
MONGO_PORT=27017
MONGO_USERNAME=your_username
MONGO_PASSWORD=your_password
# 或直接指定完整连接串
# MONGO_SMARTCARE_URI=mongodb://user:pass@host:port/SmartCare

# DataCenter 医嘱库（VI_ICU_ZYYZ）
MONGO_DATACENTER_HOST=your_datacenter_host
MONGO_DATACENTER_PORT=27017
MONGO_DATACENTER_USERNAME=your_username
MONGO_DATACENTER_PASSWORD=your_password
# 或直接指定完整连接串
# MONGO_DATACENTER_URI=mongodb://user:pass@host:port/DataCenter

# Server Configuration
SERVER_PORT=8080

# Hospital Name
HOSPITAL_NAME=your_hospital_name
